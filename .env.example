# ==========================================
# Email Notification Configuration
# ==========================================

# Set to 'true' to enable Email notifications
EMAIL_ENABLED=false

# Minimum time (in seconds) between Email notifications to prevent spam
EMAIL_RATE_LIMIT_SECONDS=300

# ==========================================
# SMTP Settings (Standard Gmail setup shown)
# ==========================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Your full email address (e.g., you@gmail.com)
SMTP_USERNAME=your_email@gmail.com

# Use an App Password if you have 2FA enabled on your Google Account
SMTP_PASSWORD=your_app_password_here

# The email address that notifications appear to be sent from
EMAIL_FROM=your_email@gmail.com

# Where to send the alerts
EMAIL_TO=recipient_email@example.com
